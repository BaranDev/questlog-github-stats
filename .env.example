# A fine-grained token with public read-only access is enough.
GITHUB_TOKEN=
# How many logins may be fetched for the first time each hour (default 600).
# NEW_LOGINS_PER_HOUR=600
# The admin pages (/admin/status, /admin/health) behind Cloudflare Access. Without all three they open only
# for a local run. The team domain and the Access app's audience tag are shown in Zero Trust, under the app.
# ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# ACCESS_AUD=
# ADMIN_EMAILS=you@example.com
